<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hydroponic_seeding_tree" model="ir.ui.view">
        <field name="name">hydroponic.seeding.list</field>
        <field name="model">hydroponic.seeding</field>
        <field name="arch" type="xml">
            <list string="Daftar Pembibitan">
                <field name="name"/>
                <field name="product_id"/>
                <field name="start_color" column_invisible="True"/>
                <field name="transfer_color" column_invisible="True"/>
                <field name="start_date" 
                       decoration-danger="start_color == 'danger'" 
                       decoration-success="start_color == 'success'" 
                       decoration-warning="start_color == 'warning'"/>
                       
                <field name="estimated_transfer_date" 
                       decoration-danger="transfer_color == 'danger'" 
                       decoration-success="transfer_color == 'success'" 
                       decoration-warning="transfer_color == 'warning'"/>
                <field name="duration"/>
                <field name="qty_seeding"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'draft'" 
                       decoration-warning="state == 'in_progress'" 
                       decoration-primary="state == 'transferred'" 
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'cancel'"/>
            </list>
        </field>
    </record>

    <record id="view_hydroponic_seeding_form" model="ir.ui.view">
        <field name="name">hydroponic.seeding.form</field>
        <field name="model">hydroponic.seeding</field>
        <field name="arch" type="xml">
            <form string="Form Pembibitan">
                <header>
                    <button name="action_cancel" type="object" string="Gagal / Cancel" 
                            class="btn-danger" 
                            invisible="state in ('transferred', 'cancel')"/>
                    
                    <field name="state" widget="statusbar" options="{'clickable': '1'}" 
                            statusbar_visible="draft,in_progress,transferred,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Informasi Tanaman">
                            <field name="product_id" placeholder="Pilih benih/sayuran..."
                                   readonly="state == 'transferred' or state == 'done' or state == 'cancel'"/>
                            <field name="qty_seeding"
                                   readonly="state == 'transferred' or state == 'done' or state == 'cancel'"/>
                        </group>
                        <group string="Siklus Waktu">
                            <field name="start_date"
                                   readonly="state == 'transferred' or state == 'done' or state == 'cancel'"/>
                            <field name="duration"
                                   readonly="state == 'transferred' or state == 'done' or state == 'cancel'"/>
                            <field name="estimated_transfer_date" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    
    <record id="view_hydroponic_seeding_calendar" model="ir.ui.view">
        <field name="name">hydroponic.seeding.calendar</field>
        <field name="model">hydroponic.seeding</field>
        <field name="arch" type="xml">
            <calendar string="Kalender Pembibitan" date_start="start_date" date_stop="estimated_transfer_date" color="state" mode="month">
                <field name="name"/>
                <field name="product_id"/>
                <field name="qty_seeding"/>
            </calendar>
        </field>
    </record>

    
    <record id="view_hydroponic_seeding_kanban" model="ir.ui.view">
        <field name="name">hydroponic.seeding.kanban</field>
        <field name="model">hydroponic.seeding</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="product_id"/>
                <field name="qty_seeding"/>
                <field name="start_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    Tanaman: <field name="product_id"/>
                                </div>
                                <div>
                                    Jumlah: <field name="qty_seeding"/>
                                </div>
                                <div>
                                    Mulai: <field name="start_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_hydroponic_seeding_search" model="ir.ui.view">
        <field name="name">hydroponic.seeding.search</field>
        <field name="model">hydroponic.seeding</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Kode Batch"/>
                <field name="product_id" string="Nama Sayuran"/>
                <filter string="Sembunyikan Gagal" name="hide_cancel" domain="<('state', '!=', 'cancel')>"/>
            </search>
        </field>
    </record>

    <record id="action_hydroponic_seeding" model="ir.actions.act_window">
        <field name="name">Pembibitan (Seeding)</field>
        <field name="res_model">hydroponic.seeding</field>
        
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="context">{'search_default_hide_cancel': 1}
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada data pembibitan.
            </p><p>
                Klik tombol "New" untuk memulai pencatatan batch pembibitan baru Anda.
            </p>
        </field>
    </record> 
</odoo>