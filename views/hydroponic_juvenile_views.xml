<odoo>
    <record id="view_hydroponic_juvenile_tree" model="ir.ui.view">
        <field name="name">hydroponic.juvenile.list</field>
        <field name="model">hydroponic.juvenile</field>
        <field name="arch" type="xml">
            <list string="Daftar Peremajaan" create="0">
                <field name="transfer_color" column_invisible="True"/>
                <field name="seeding_id"/>
                <field name="product_id"/>
                <field name="juvenile_product_id"/>
                <field name="estimated_start_date" 
                       decoration-danger="transfer_color == 'danger'" 
                       decoration-success="transfer_color == 'success'" 
                       decoration-warning="transfer_color == 'warning'"/>
                <field name="duration"/>
                <field name="qty_alive"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'in_progress'" decoration-primary="state == 'transferred'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_hydroponic_juvenile_form" model="ir.ui.view">
        <field name="name">hydroponic.juvenile.form</field>
        <field name="model">hydroponic.juvenile</field>
        <field name="arch" type="xml">
            <form string="Form Peremajaan" create="0">
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}" statusbar_visible="draft,in_progress,transferred,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="seeding_id"/></h1>
                    </div>
                    <group>
                        <group string="Data dari Pembibitan (Read-only)">
                            <field name="product_id"/>
                            <field name="estimated_start_date"/>
                            <field name="qty_seeding"/>
                        </group>
                        <group string="Proses Peremajaan">
                            <field name="juvenile_product_id" placeholder="Pilih sayur hasil peremajaan..." readonly="state == 'transferred' or state == 'done' or state == 'cancel'" force_save="1"/>
                            <field name="qty_dead" readonly="state == 'transferred' or state == 'done' or state == 'cancel'" force_save="1"/>
                            <field name="qty_alive" readonly="state == 'transferred' or state == 'done' or state == 'cancel'" force_save="1"/>
                            <field name="duration" readonly="state == 'transferred' or state == 'done' or state == 'cancel'" force_save="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    
    <record id="view_hydroponic_juvenile_calendar" model="ir.ui.view">
        <field name="name">hydroponic.juvenile.calendar</field>
        <field name="model">hydroponic.juvenile</field>
        <field name="arch" type="xml">
            <calendar string="Kalender Peremajaan" date_start="estimated_start_date" color="state" mode="month">
                <field name="seeding_id"/>
                <field name="product_id"/>
                <field name="qty_alive"/>
            </calendar>
        </field>
    </record>

    
    <record id="view_hydroponic_juvenile_kanban" model="ir.ui.view">
        <field name="name">hydroponic.juvenile.kanban</field>
        <field name="model">hydroponic.juvenile</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="seeding_id"/>
                <field name="product_id"/>
                <field name="qty_alive"/>
                <field name="estimated_start_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="seeding_id"/>
                                </strong>
                                <div>
                                    Tanaman: <field name="product_id"/>
                                </div>
                                <div>
                                    Bibit Hidup: <field name="qty_alive"/>
                                </div>
                                <div>
                                    Estimasi Mulai: <field name="estimated_start_date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_hydroponic_juvenile" model="ir.actions.act_window">
        <field name="name">Peremajaan (Juvenile)</field>
        <field name="res_model">hydroponic.juvenile</field>
        
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada data peremajaan.
            </p>
            <p>
                Data akan otomatis muncul di sini ketika status pada menu Pembibitan diubah menjadi "Pindah Tanam".
            </p>
        </field>
    </record>
</odoo>